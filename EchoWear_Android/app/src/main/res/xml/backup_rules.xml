<?xml version="1.0" encoding="utf-8"?>
<!-- Health records and the encrypted database must never leave the device in
     a cloud backup. -->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="echowear_secure.xml" />
    <exclude domain="file" path="datastore" />
</full-backup-content>
